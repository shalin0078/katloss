# Dependencies
node_modules/
frontend/node_modules/

# Production build artifacts
dist/
frontend/dist/
frontend/dist-ssr/

# Python cache & virtual environments
__pycache__/
*/__pycache__/
*/*/__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/

# Pytest & logs
.pytest_cache/
*.log
npm-debug.log*
yarn-debug.log*

# Backend storage (keep directories via .gitkeep, ignore actual uploads & outputs)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
backend/storage/outputs/*
!backend/storage/outputs/.gitkeep

# Environment & local settings
.env
.env.local
.env.*.local
*.local

# IDE & OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
